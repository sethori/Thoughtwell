{
  "name": "@notes/desktop",
  "productName": "Thoughtwell",
  "version": "0.0.0",
  "private": true,
  "description": "Thoughtwell desktop app: a local-first second brain stored as Markdown files",
  "author": "Thoughtwell",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && THOUGHTWELL_DEV_URL=http://localhost:5173 THOUGHTWELL_RESOURCES=. electron .",
    "package": "pnpm --filter @notes/web build && node scripts/build.mjs && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@notes/shared": "workspace:*",
    "@notes/vault": "workspace:*",
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "app.thoughtwell.desktop",
    "productName": "Thoughtwell",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "Thoughtwell-${version}-${arch}.AppImage"
    }
  }
}
