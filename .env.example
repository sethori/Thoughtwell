# Copy to .env and fill in. Never commit .env.

# Postgres superuser/owner used by docker compose and for migrations
POSTGRES_USER=notes_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=notes

# Owner connection: runs migrations and the seed script only
DATABASE_URL=postgres://notes_owner:change-me-owner@localhost:5432/notes

# Restricted app role: the API connects with this. Row-level security applies to it.
APP_DB_PASSWORD=change-me-app
APP_DATABASE_URL=postgres://notes_app:change-me-app@localhost:5432/notes

# API
API_PORT=3000
# 32+ random characters; signs session cookies
SESSION_SECRET=replace-with-a-long-random-string
# Set to true behind HTTPS (your nginx subdomain)
COOKIE_SECURE=false
# The address people open, for links in email and Teams notifications
PUBLIC_URL=http://localhost:8080
# Where uploaded images and files are stored (local disk driver in phase 1)
STORAGE_DIR=./data/assets

# First admin, created by `pnpm db:seed`
SEED_ADMIN_USERNAME=seth
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_DISPLAY_NAME=Seth
SEED_ORG_NAME=My Organization

# Web container port that your nginx proxies to
WEB_PORT=8080

# Interface the web port binds to. 127.0.0.1 when nginx runs on this same host;
# 0.0.0.0 (or the server's LAN/VPN IP) when nginx is on another machine.
WEB_BIND=127.0.0.1

# Optional: store data at a real path instead of Docker volumes (recommended on Unraid).
# Leave unset elsewhere. Use the cache pool path, not /mnt/user, for the database.
# PGDATA_DIR=/mnt/cache/appdata/notes-platform/pgdata
# ASSETS_DIR=/mnt/user/appdata/notes-platform/assets
