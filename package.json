{
  "name": "thoughtwell",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first second brain: your notes and your AI agents' notes, as Markdown files on your computer",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @notes/web --filter @notes/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:version",
    "test:version": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "desktop:package": "pnpm --filter @notes/desktop package",
    "mcp": "pnpm --filter @notes/mcp start"
  }
}
